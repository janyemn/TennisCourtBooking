      "body": { "venueId": "{{venueId}}", "sportId": "{{sportId}}", "date": "{{date}}", "courtId": "{{courtId}}", "slotIds": "{{slotIds}}" },
      "assertions": [{ "path": "code", "equals": 0 }]
    },
