      "assertions": [{ "path": "code", "equals": 0 }]
    },
    "slots": {
      "evidence": "REPLACE: 本人HAR中的场次查询请求序号",
      "url": "https://replace-with-captured-host.invalid/slots",
      "method": "GET", "encoding": "none", "readOnly": true,
      "query": { "venueId": "{{venueId}}", "sportId": "{{sportId}}", "date": "{{date}}" },
      "assertions": [{ "path": "code", "equals": 0 }]
    },
    "hold": {
